# Copiá este archivo como .env y completá con tus datos
PORT=3000

DB_NAME=infohub
DB_USER=root
DB_PASS=
DB_HOST=localhost
DB_PORT=3306

# true = Sequelize ajusta las tablas a los modelos al iniciar (solo desarrollo)
DB_SYNC_ALTER=false

JWT_SECRET=cambiar-por-un-secreto-largo
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# ---------- Archivos ----------
UPLOADS_DIR=uploads

# ---------- IA ----------
# auto     = Gemini primero y OpenRouter como respaldo ante 429/5xx.
# gemini   = solo Google Gemini.
# openrouter = solo OpenRouter.
# simulado = respuestas de ejemplo sin internet.
# ninguno  = sin IA: se usan los análisis locales cuando es posible.
IA_PROVEEDOR=gemini

# Google Gemini / AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=

# OpenRouter: permite usar modelos gratuitos mediante el router openrouter/free.
# Creá la clave en https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=InfoHub
